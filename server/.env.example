DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parenting_app?schema=public"
PORT=4000

JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d

# 소셜 로그인 (선택) - 비워두면 해당 프로바이더 로그인만 비활성화되고 서버는 정상 기동합니다.
# Google Cloud Console > OAuth 클라이언트 ID(웹 애플리케이션)에서 발급받은 클라이언트 ID.
GOOGLE_CLIENT_ID=
